# Copy this file to .env and fill in your API keys.
# scripts/evaluation/.env is gitignored.

# Required for the openai-* bots:
OPENAI_API_KEY=

# Required for the anthropic-* bots:
ANTHROPIC_API_KEY=

# Optional: limit which bots run. Comma-separated list of bot IDs from
# scripts/evaluation/bots.py. Default: all configured bots.
# WARDENBOT_EVAL_BOTS=openai-gpt-4o-mini,vulnerable-stub
